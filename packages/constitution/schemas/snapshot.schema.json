{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ds-superbot.local/schema/snapshot.json",
  "title": "ConstitutionSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "capturedAt",
    "docTier",
    "policyRev",
    "bindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^CS-[0-9a-f]{12}$"
    },
    "capturedAt": {
      "type": "string"
    },
    "docTier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "policyRev": {
      "type": "string"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
