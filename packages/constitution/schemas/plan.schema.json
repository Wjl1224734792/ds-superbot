{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ds-superbot.local/schema/plan.json",
  "title": "Plan",
  "description": "Existing 03-plan.json schemaVersion 1, plus docsRead required at docTier=3.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "impact",
    "acceptanceCriteria",
    "testChanges",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "impact": {
      "type": "string"
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "coveredBy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[A-Za-z0-9._-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "coveredBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "testChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "task",
          "reason"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "title",
          "files",
          "newFiles",
          "dependsOn",
          "doneWhen"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "newFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "doneWhen": {
            "type": "string"
          },
          "docsRead": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
