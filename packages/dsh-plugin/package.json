{
  "name": "@ds-superbot/plugin",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "Internal DSH plugin implementation for ds-superbot. The install entry is the repository root package named ds-superbot.",
  "license": "MIT",
  "author": "Lin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wjl1224734792/ds-superbot.git"
  },
  "homepage": "https://github.com/Wjl1224734792/ds-superbot#readme",
  "bugs": {
    "url": "https://github.com/Wjl1224734792/ds-superbot/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "subagent",
    "multi-agent",
    "engineering-team",
    "documentation-pipeline"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "skills/**",
    "roles/**",
    "scripts/**",
    "assets/**",
    "lib/**",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node ../../scripts/ensure-schemastery-stub.mjs && node --test tests/*.mjs",
    "check": "node --check index.js && node --check client.js && node --check scripts/docs-ready.mjs && node --check scripts/lib/docs-state.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
